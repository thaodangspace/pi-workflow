{
  "name": "pi-workflow",
  "version": "0.1.0",
  "description": "Workflow engine for Pi coding agent",
  "keywords": [
    "pi-package",
    "pi",
    "workflow",
    "agent"
  ],
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "piWorkflow": {
    "piLoopService": {
      "contractVersion": 1,
      "source": "pi-loop/service",
      "pin": "https://codeload.github.com/thaodangspace/pi-loop/tar.gz/82ffd75926a9532ef44e0e5dd8bfb4cfeefae044"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-reporter=spec test/*.test.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.87.1"
  },
  "dependencies": {
    "pi-loop": "https://codeload.github.com/thaodangspace/pi-loop/tar.gz/82ffd75926a9532ef44e0e5dd8bfb4cfeefae044",
    "typebox": "^1.3.27",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
